-	sandboxName := fmt.Sprintf("agent-%s-%d-%d", strings.ToLower(agentName), os.Getpid(), time.Now().Unix())
+	// OpenShell limits sandbox names to 19 characters. Keep the agent prefix
+	// readable, then append a short nanosecond-derived suffix for uniqueness.
+	// The previous PID+Unix-seconds form exceeded that limit for normal agent
+	// names such as "triage" and failed before a sandbox was created.
+	const maxSandboxNameLength = 19
+	suffix := fmt.Sprintf("%05x", uint64(time.Now().UnixNano())&0xfffff)
+	prefix := "agent-" + strings.ToLower(agentName)
+	maxPrefixLength := maxSandboxNameLength - 1 - len(suffix)
+	if len(prefix) > maxPrefixLength {
+		prefix = prefix[:maxPrefixLength]
+	}
+	sandboxName := prefix + "-" + suffix
